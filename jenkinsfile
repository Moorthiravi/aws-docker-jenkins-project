pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Repository fetched successfully.'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t my-website-image .'
            }
        }

        stage('Deploy Website') {
            steps {
                sh '''
                    docker rm -f my-website || true
                    docker run -d --name my-website -p 8080:80 my-website-image
                '''
            }
        }
    }
}
